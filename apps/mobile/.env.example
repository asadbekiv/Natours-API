# The API base URL the mobile app calls. EXPO_PUBLIC_ prefix is required for
# the value to be embedded into the app bundle (Expo convention).
#
# Local dev (your machine's LAN IP — NOT localhost, that's the phone's localhost):
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:4000/api/v1
#
# Production (after the Render cutover):
#   EXPO_PUBLIC_API_URL=https://your-natours.onrender.com/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
