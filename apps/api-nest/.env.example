# Copy to .env and fill in. Reuse the same Atlas connection string as apps/api.
DATABASE=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/natours?retryWrites=true&w=majority
PORT=4000
NODE_ENV=development

# Comma-separated CORS allowlist (optional). If unset, all origins are reflected
# (fine for dev). Set it to your web/mobile origins before going live.
# CORS_ORIGIN=https://yourapp.com,https://admin.yourapp.com

# Auth — short-lived access JWT + long-lived refresh tokens (POST /users/refresh)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
# Refresh-token lifetime in days (opaque token, stored hashed in Mongo)
REFRESH_TOKEN_EXPIRES_DAYS=90

# Stripe (reuse the apps/api values)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ImageKit (image storage; see imagekit.io dashboard → Developer options)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-id

# Email — dev SMTP (e.g. Mailtrap); prod uses the MAILGUN_* values
EMAIL_FROM=no-reply@natours.io
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=your-mailtrap-user
EMAIL_PASSWORD=your-mailtrap-pass
# Production SMTP (Resend) — used when NODE_ENV=production
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend            # literally the word "resend"
# SMTP_PASS=re_your_api_key   # your Resend API key
