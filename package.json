{
  "name": "natours-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.0",
  "description": "Natours monorepo — API and shared packages",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "start": "npm run start --workspace=@natours/api"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "turbo": "^2.0.0"
  },
  "overrides": {
    "rxjs": "7.8.1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2"
  }
}
